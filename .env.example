# Copia este archivo como .env.local y llena los valores de tu proyecto Supabase
# (Supabase → Project Settings → API).
# Si estas variables están vacías, B-POS funciona en modo local (solo este navegador).

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-llave-anon-o-publishable

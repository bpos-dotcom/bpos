{
  "name": "bpos-agent",
  "version": "2.0.0",
  "description": "B-POS Agent: lee los pedidos de delivery, imprime y se conecta a B-POS en la nube",
  "main": "main.js",
  "author": "B-POS",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "adm-zip": "^0.5.18",
    "cors": "^2.8.5",
    "electron-updater": "^6.6.2",
    "express": "^4.18.3",
    "node-thermal-printer": "^4.6.0",
    "pdf2json": "^4.0.3",
    "pdfjs-dist": "^6.1.200",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.burgerplanet.bposagent",
    "productName": "B-POS",
    "executableName": "B-POS",
    "copyright": "B-POS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "lib/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "virtual-printer",
        "to": "virtual-printer"
      },
      {
        "from": "tessdata",
        "to": "tessdata"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "BPOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "B-POS",
      "uninstallDisplayName": "B-POS",
      "runAfterFinish": true,
      "include": "installer/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bpos-dotcom",
        "repo": "bpos",
        "releaseType": "release"
      }
    ]
  },
  "productName": "B-POS"
}

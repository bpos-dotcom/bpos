{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "bpos",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "bpos" }],
  "observability": { "enabled": true },
  // Tareas programadas (ver custom-worker.ts)
  "triggers": { "crons": ["0 14 * * 1"] },
  // Dominio propio (la zona bpos.com.mx vive en Cloudflare)
  "workers_dev": true,
  "routes": [
    { "pattern": "www.bpos.com.mx", "custom_domain": true },
    { "pattern": "bpos.com.mx", "custom_domain": true },
    // Dominios propios de los negocios (a qué página llevan: variable DOMAIN_REDIRECTS de la compilación)
    { "pattern": "burgerplanet.com.mx", "custom_domain": true },
    { "pattern": "www.burgerplanet.com.mx", "custom_domain": true }
  ],
  // Valores que no son secretos (los secretos se guardan en el panel de Cloudflare)
  "vars": {
    "GOOGLE_WALLET_ISSUER_ID": "3388000000023229508",
    "MP_CLIENT_ID": "5461571198046273"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "bpos",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "bpos" }],
  "observability": { "enabled": true },
  // Valores que no son secretos (los secretos se guardan en el panel de Cloudflare)
  "vars": {
    "GOOGLE_WALLET_ISSUER_ID": "3388000000023229508",
    "MP_CLIENT_ID": "5461571198046273"
  }
}
